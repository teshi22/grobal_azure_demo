AZURE_AI_PROJECT_ENDPOINT=https://<your-account>.services.ai.azure.com/api/projects/travel-agent
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4
HOSTED_AGENT_NAME=travel-request-agent
HOSTED_AGENT_VERSION=<pinned-hosted-agent-version>
SINGLE_PROMPT_AGENT_NAME=travel-request-single-agent
SINGLE_PROMPT_AGENT_VERSION=<pinned-single-agent-version>
EVALUATION_JUDGE_MODEL=gpt-5.4
COSMOS_ENDPOINT=https://<cosmos-account>.documents.azure.com:443/
COSMOS_DATABASE=travel-agent
COSMOS_CHECKPOINT_CONTAINER=workflow-checkpoints
COSMOS_EVENT_CONTAINER=conversation-events
COSMOS_CONVERSATION_CONTAINER=conversations
COSMOS_TRAVEL_REQUEST_CONTAINER=travel-requests
COSMOS_APPROVAL_GRANT_CONTAINER=approval-grants
COSMOS_EVALUATION_CASE_CONTAINER=evaluation-cases
COSMOS_EVALUATION_RUN_CONTAINER=evaluation-runs
COSMOS_EVALUATION_RESULT_CONTAINER=evaluation-results
APPLICATIONINSIGHTS_CONNECTION_STRING=<app-insights-connection-string>
MCP_TOOL_ENDPOINT=https://<function-app>.azurewebsites.net/api/mcp
MCP_FUNCTION_APP_CLIENT_ID=<entra-app-client-id>
ENTRA_TENANT_ID=<tenant-id>
ENTRA_CLIENT_ID=<bff-app-client-id>
# ローカル開発時のCORS設定 (本番では不要)
CORS_ORIGINS=["http://localhost:3000"]
ENABLE_DOCS=true
