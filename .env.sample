AZURE_AI_PROJECT_ENDPOINT=https://<your-account>.services.ai.azure.com/api/projects/travel-agent
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4
BING_CONNECTION_NAME=<account>-bing-grounding
BING_PROJECT_CONNECTION_ID=<full-resource-id-of-bing-connection>
APPLICATIONINSIGHTS_CONNECTION_STRING=<app-insights-connection-string>
TRAVEL_PLANNER_AGENT=TravelPlanner
POLICY_CHECKER_AGENT=PolicyChecker
APPROVAL_AGENT=ApprovalAgent
MCP_TOOL_ENDPOINT=https://<function-app>.azurewebsites.net/api/mcp
MCP_FUNCTION_APP_CLIENT_ID=<entra-app-client-id>
# ローカル開発時のCORS設定 (本番では不要)
CORS_ORIGINS=["http://localhost:3000"]
ENABLE_DOCS=true
